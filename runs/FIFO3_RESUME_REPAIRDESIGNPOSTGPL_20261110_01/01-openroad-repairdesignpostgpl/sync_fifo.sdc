###############################################################################
# Created by write_sdc
###############################################################################
current_design sync_fifo
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name core_clk -period 10.0000 [get_ports {clk}]
set_clock_transition 0.1000 [get_clocks {core_clk}]
set_clock_uncertainty 0.2000 core_clk
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_en}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_en}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[0]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[0]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[1]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[1]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[2]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[2]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[3]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[3]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[4]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[4]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[5]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[5]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[6]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[6]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_data[7]}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_data[7]}]
set_input_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {wr_en}]
set_input_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {wr_en}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {almost_empty}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {almost_empty}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {almost_full}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {almost_full}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {empty}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {empty}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {full}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {full}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {occupancy[0]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {occupancy[0]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {occupancy[1]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {occupancy[1]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {occupancy[2]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {occupancy[2]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {occupancy[3]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {occupancy[3]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {occupancy[4]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {occupancy[4]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[0]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[0]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[1]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[1]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[2]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[2]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[3]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[3]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[4]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[4]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[5]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[5]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[6]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[6]}]
set_output_delay 0.0000 -clock [get_clocks {core_clk}] -min -add_delay [get_ports {rd_data[7]}]
set_output_delay 1.0000 -clock [get_clocks {core_clk}] -max -add_delay [get_ports {rd_data[7]}]
set_false_path\
    -from [get_ports {rst_n}]
###############################################################################
# Environment
###############################################################################
set_load -pin_load 0.0100 [get_ports {almost_empty}]
set_load -pin_load 0.0100 [get_ports {almost_full}]
set_load -pin_load 0.0100 [get_ports {empty}]
set_load -pin_load 0.0100 [get_ports {full}]
set_load -pin_load 0.0100 [get_ports {occupancy[4]}]
set_load -pin_load 0.0100 [get_ports {occupancy[3]}]
set_load -pin_load 0.0100 [get_ports {occupancy[2]}]
set_load -pin_load 0.0100 [get_ports {occupancy[1]}]
set_load -pin_load 0.0100 [get_ports {occupancy[0]}]
set_load -pin_load 0.0100 [get_ports {rd_data[7]}]
set_load -pin_load 0.0100 [get_ports {rd_data[6]}]
set_load -pin_load 0.0100 [get_ports {rd_data[5]}]
set_load -pin_load 0.0100 [get_ports {rd_data[4]}]
set_load -pin_load 0.0100 [get_ports {rd_data[3]}]
set_load -pin_load 0.0100 [get_ports {rd_data[2]}]
set_load -pin_load 0.0100 [get_ports {rd_data[1]}]
set_load -pin_load 0.0100 [get_ports {rd_data[0]}]
set_input_transition 0.1000 [get_ports {rd_en}]
set_input_transition 0.1000 [get_ports {wr_en}]
set_input_transition 0.1000 [get_ports {wr_data[7]}]
set_input_transition 0.1000 [get_ports {wr_data[6]}]
set_input_transition 0.1000 [get_ports {wr_data[5]}]
set_input_transition 0.1000 [get_ports {wr_data[4]}]
set_input_transition 0.1000 [get_ports {wr_data[3]}]
set_input_transition 0.1000 [get_ports {wr_data[2]}]
set_input_transition 0.1000 [get_ports {wr_data[1]}]
set_input_transition 0.1000 [get_ports {wr_data[0]}]
